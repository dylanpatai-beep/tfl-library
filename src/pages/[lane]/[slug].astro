---
import Base from '../../layouts/Base.astro';
import { LANES, getLane } from '../../lib/lanes';
import { getLaneEntries, SHOW_DRAFTS } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const paths = [];
  for (const lane of LANES) {
    const entries = await getLaneEntries(lane);
    entries.forEach((entry, i) => {
      paths.push({ params: { lane: lane.id, slug: entry.id }, props: { entry, serial: i + 1 } });
    });
  }
  return paths;
}

const lane = getLane(Astro.params.lane!);
const { entry, serial } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${d.title} — ${lane.name} — The Fight Life Library`} description={d.summary} active={lane.id}>
  <section class="entry-page">
    <div class="entry-inner">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">LIBRARY</a>
        <span class="sep">→</span>
        <a href={`/${lane.id}/`}>{lane.name}</a>
        <span class="sep">→</span>
        <span class="current">{d.title}</span>
      </nav>

      {SHOW_DRAFTS && d.status === 'draft' && (
        <div class="sec-label"><span class="num">DRAFT</span> / DEV ONLY — NOT ON THE LIVE SITE</div>
      )}

      {/* Same frame skeleton as a lane card. The chip carries the entry's
          serial — the doc's "NO 07" case. */}
      <div class="entry-head frame">
        <div class="f-wash"></div>
        <div class="f-num">{lane.pillar.num}</div>
        <div class="f-corner tl"><i></i><i></i><i></i></div>
        <div class="f-corner tr"><i></i><i></i><i></i></div>

        <div class="f-kicker eh-kicker">
          <span class="f-chip">NO {String(serial).padStart(2, '0')}</span>
          <span>{lane.sub}</span>
        </div>
        <h1 class="entry-title">{d.title}</h1>
        <p class="entry-lede">{d.summary}</p>
        <div class="signoff">THEFIGHTLIFE</div>
      </div>

      <div class="meta-strip">
        {lane.meta(d).map((cell) => (
          <div class="meta-cell">
            <div class="mc-label">{cell.label}</div>
            <div class="mc-value">
              {cell.href ? <a href={cell.href} rel="noopener">{cell.value}</a> : cell.value}
            </div>
          </div>
        ))}
        <div class="meta-cell">
          <div class="mc-label">Added</div>
          <div class="mc-value">{dateStr}</div>
        </div>
      </div>

      <article class="prose" data-pagefind-body data-pagefind-filter={`lane:${lane.id}`}>
        <Content />
      </article>

      <div class="entry-foot">
        {d.tags.length > 0 && (
          <div class="tag-row">
            <span class="tr-label">Tagged</span>
            {d.tags.map((t: string) => <span class="badge">{t}</span>)}
          </div>
        )}
        {d.source_url && (
          <a class="back-link" href={d.source_url} rel="noopener">SOURCE ↗</a>
        )}
        <a class="back-link" href={`/${lane.id}/`}>← ALL {lane.name.toUpperCase()}</a>
      </div>
    </div>
  </section>
</Base>
